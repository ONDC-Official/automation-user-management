PORT=8080
ENV=development

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=developer_guide_db

# JWT
JWT_SECRET=

# MCP API keys
# MCP_KEY_TTL_DAYS must match section 3 of the MCP consent document. If you
# change it, change the document and bump MCP_CONSENT_VERSION too.
MCP_KEY_TTL_DAYS=90
MCP_CONSENT_VERSION=2026-10-v1
# Optional. When set, /mcp/verify additionally requires a matching
# X-Service-Token header. Generate with: openssl rand -base64 32
MCP_SERVICE_TOKEN=
